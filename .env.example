# 1145cx onboarding — non-secret settings for local dev / CI
# Copy to .env and fill in ONLY for local testing (never commit .env)
# Secrets go in AWS Secrets Manager, not here.

CX_ENV=sandbox
AWS_REGION=us-east-1
AWS_PROFILE=1145ai
SECRETS_BACKEND=env   # use env vars instead of Secrets Manager in tests

# DynamoDB Local endpoint (for integration tests)
# DYNAMODB_ENDPOINT=http://localhost:8000

# Switches (all off by default)
NUMBER_ORDER_ENABLED=false
OUTBOUND_CALLS_ENABLED=false
ENRICH_PAID_SOURCES=false
BOOKING_SCOUT_ENABLED=false
TWILIO_ENABLED=false

# Limits
RATE_LIMIT_PER_MIN=20
MAX_TURNS_PER_SESSION=300
NUMBER_DAILY_CAP=5
RESEARCH_DAILY_CAP=10
